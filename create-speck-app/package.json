{
  "name": "create-speck-app",
  "version": "0.5.1",
  "description": "Scaffold a new Speck.js application",
  "type": "module",
  "bin": {
    "create-speck-app": "./index.js"
  },
  "files": [
    "index.js",
    "template/api",
    "template/compiler",
    "template/plugins",
    "template/public",
    "template/src",
    "template/.env.example",
    "template/gitignore",
    "template/index.html",
    "template/nodemon.json",
    "template/package.json",
    "template/package-lock.json",
    "template/SPECK_GUIDE.md",
    "template/vite.config.js"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/clean-template.mjs"
  },
  "keywords": [
    "speck",
    "speckjs",
    "framework",
    "reactive",
    "create-app",
    "scaffold"
  ],
  "author": "Peter M. Pagano",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/petermpagano/speckjs"
  },
  "homepage": "https://speckjs.dev",
  "engines": {
    "node": ">=18.0.0"
  }
}
